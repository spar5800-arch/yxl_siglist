<script>
function startRecap() {
    // 1. 사용할 스크립트 코드
    const code = "!function(){let s=document.createElement('script');s.src='https://cdn.jsdelivr.net/gh/jebibot/sp-recap/mobile.js',document.head.appendChild(s)}();";
    const fullCode = "javascript:" + code;

    // 2. 클립보드에 자동 복사
    navigator.clipboard.writeText(fullCode).then(() => {
        alert("스크립트가 복사되었습니다!\n\n다음 페이지 주소창에 '붙여넣기(Ctrl+V)' 후 엔터를 누르세요.");
        
        // 3. SOOP 통계 페이지로 자동 이동
        window.open("https://m.sooplive.com/statistics/a/watch/?szModule=UserLiveWatchTimeData&szMethod=watch", "_blank");
    });
}
</script>

<!-- 홈페이지에 넣을 버튼 -->
<button onclick="startRecap()" style="padding: 20px 40px; font-size: 18px; cursor: pointer;">
    🚀 리캡 시작하기 (클릭 시 자동 복사 및 이동)
</button>
